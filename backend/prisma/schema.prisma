// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  PLAYER
  HOST
  ADMIN
}

enum TournamentStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// 🚀 NEW: Status for Screenshot Verification
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- MODELS ---
model User {
  id               String   @id @default(uuid())
  username         String   @unique
  email            String   @unique
  passwordHash     String
  freeFireUid      String?  @unique
  role             Role     @default(PLAYER)
  isBanned         Boolean  @default(false)
  
  // 💰 THE TRIPLE WALLET SYSTEM
  depositBalance   Float    @default(0.00)
  winningBalance   Float    @default(0.00)
  bonusBalance     Float    @default(0.00)
  
  hasAcceptedTerms Boolean  @default(false)
  termsAcceptedAt  DateTime?
  state            String?  // 🚀 NEW: Razorpay Geofencing requirement

  // 🚀 REFERRAL ENGINE
  referralCode     String?  @unique @default(uuid())
  referredBy       String?  
  paidMatchesCount Int      @default(0) 
  
  tournaments      Tournament[]
  transactions     Transaction[]
  
  // 🚀 NEW: Relation to their uploaded match results
  matchResults     MatchResult[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Transaction {
  id                String            @id @default(uuid())
  amount            Float
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  description       String?           
  upiId             String?           // 🚀 NEW: For withdrawal requests
  
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Tournament {
  id                  String           @id @default(uuid())
  title               String
  description         String?
  gameName            String           @default("Free Fire")
  
  map                 String           @default("Bermuda")
  teamMode            String           @default("Solo")
  minLevel            Int              @default(40)
  
  entryFee            Float            @default(0.00)
  prizePool           Float            @default(0.00)
  maxParticipants     Int              @default(48)
  currentParticipants Int              @default(0)
  status              TournamentStatus @default(UPCOMING)
  scheduledAt         DateTime
  
  roomId              String?
  roomPassword        String?

  participants        User[]

  // 🚀 NEW: Relation to results submitted for this tournament
  matchResults        MatchResult[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// 🚀 NEW MODEL: Match Result Screenshot Verification
model MatchResult {
  id           String             @id @default(uuid())
  imageUrl     String             // The hosted URL of the screenshot
  status       VerificationStatus @default(PENDING)
  
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId String

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Ensures a user can only submit one screenshot per tournament
  @@unique([userId, tournamentId])
}